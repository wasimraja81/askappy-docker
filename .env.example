# Multi-Project Docker Environment Variables
# Copy this file to .env and customize as needed

# Build metadata
BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
VCS_REF=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
VERSION=latest

# Build configuration
CPU_CORE_COUNT=4

# Development settings
DISPLAY=:0

# Volumes (customize paths as needed)
DATA_DIR=./data
NOTEBOOKS_DIR=./notebooks
SCRIPTS_DIR=./scripts

# Project-specific settings
# Uncomment and customize as needed for each project

# askappy-base settings
# ASKAPPY_BASE_TAG=base-mpich-casacore-3.6.1

# tostool settings  
# TOSTOOL_TAG=mpich-casacore-3.6.1
